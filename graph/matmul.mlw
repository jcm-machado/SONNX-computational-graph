module OPMatmul
    use tensor.Tensor
    use tensor.Range
    use std.Int
    use real.Real
    use int.Int
    use list.List
    use list.Length
 
    let rec ghost function dot_product (a b: tensor real) (row col i iter: int) : real
    variant { Int.(iter - i) }
    =
    if Int.(>=) i iter then
        0.0
    else
        let a_val = a.data (Cons row (Cons i Nil)) in
        let b_val = b.data (Cons i (Cons col Nil)) in
        Real.(a_val * b_val + dot_product a b row col Int.(i + 1) iter)
 
 
    let rec lemma dot_product_aux_step (a b: tensor real) (row col i k iter: int)
    requires { Int.(i <= k < iter) }
    variant { Int.(k - i) }
    ensures {
        let a_val = a.data (Cons row (Cons k Nil)) in
        let b_val = b.data (Cons k (Cons col Nil)) in
        dot_product a b row col i Int.(k + 1) =
            Real.(dot_product a b row col i k + a_val * b_val)
    }
    =
    if i < k then 
        Real.(dot_product_aux_step a b row col (i + 1) k iter) 
    else 
        ()
 
    function dmatmul (a b: tensor real) (a_rows b_cols : int) : data real
    =  
    let iter = get_dim a.dims 1 in
    let y_shape = Cons a_rows (Cons b_cols Nil) in
    fun ks ->
        if valid ks y_shape then
            let row = get_dim ks 0 in
            let col = get_dim ks 1 in
            dot_product a b row col 0 iter
        else
            a.background
 
 
    let ghost function matmul ( a b: tensor real) : tensor real
    requires { a.background = b.background }
    requires { length a.dims = length b.dims = 2 }
    requires { get_dim a.dims 1 = get_dim b.dims 0 }
    ensures { result.background = a.background }
    ensures { result.dims = Cons (get_dim a.dims 0) (Cons (get_dim b.dims 1) Nil) }
    ensures { result.data = dmatmul a b (get_dim a.dims 0) (get_dim b.dims 1) }
    =
    { dims = Cons (get_dim a.dims 0) (Cons (get_dim b.dims 1) Nil) ; data = dmatmul a b (get_dim a.dims 0) (get_dim b.dims 1) ; background = a.background }

end

module OPMatmulGraph
    use option.Option
    use entities.WrapperTensor
    use entities.TensorValue
    use list.Length
    use std.Int
    use tensor.Tensor
    use OPMatmul
 
    predicate constraints (a b: tensor_value) =
    match a, b with
        | Some (R a_real), Some (R b_real) ->
            a_real.background = b_real.background /\
            length a_real.dims = length b_real.dims = 2 /\
            get_dim a_real.dims 1 = get_dim b_real.dims 0
        | _ -> False
    end
 
    let ghost function matmul_graph (a b: tensor_value) : tensor_value
    requires { constraints a b }
    =
    match a, b with
        | Some (R a_real), Some (R b_real) -> Some (R (OPMatmul.matmul a_real b_real))
        | _ -> None
    end
 
end

module COPMatmul
    use OPMatmul
    use real.Real
    use int.Int
    use mach.int.Int32
    use std.Cfloat
    use std.Int
    use tensor.Tensor
    use tensor.Range
    use layout.CFlat
    use libtensor.CTensor
    use libvector.CIndex
    use std.Clib
    use list.List
    use list.Length
 
    let rec lemma valid_bounds_2 (ks ds: iarray) (p q: int)
    requires { p <= q }
    requires { valid_range ks p q }
    requires { valid_range ds p q }
    requires { pdim ds p q }
    requires  { forall i. p <= i < q -> 0 <= value_at ks i < value_at ds i }
    ensures { Range.valid (islice ks p q) (islice ds p q) }
    variant  { q - p }
    = if p < q then
        begin
            assert { islice ks p q = Cons (Int32.to_int (value_at ks p)) (islice ks (p+1) q) };
            assert { islice ds p q = Cons (Int32.to_int (value_at ds p)) (islice ds (p+1) q) };
            valid_bounds_2 ks ds (p+1) q
        end
 
    let matmul (a b r: ctensor) : bool
    requires { valid_tensor a }
    requires { valid_tensor b }
    requires { valid_tensor r }
    requires { value_at a.t_dims 1 = value_at b.t_dims 0 }
    requires { value_at r.t_dims 0 = value_at a.t_dims 0 }
    requires { value_at r.t_dims 1 = value_at b.t_dims 1 }
    requires { a.t_rank = b.t_rank = r.t_rank = 2 }
    (*New*)
    requires { length (ref_tensor a).Tensor.dims = length (ref_tensor b).Tensor.dims = length (ref_tensor r).Tensor.dims = 2 }
    requires { get_dim (ref_tensor a).Tensor.dims 1 = get_dim (ref_tensor b).Tensor.dims 0 }
    (*---*)
    ensures { result -> ref_tensor r = matmul (ref_tensor a) (ref_tensor b) }
    =
    let ghost matmul_result = matmul (ref_tensor a) (ref_tensor b) in
    assert { matmul_result.dims = ivector r.t_dims r.t_rank };
 
    let rows = a.t_dims[0] in
    let cols = b.t_dims[1] in
    let iter = a.t_dims[1] in
    let ref flag = False in
    let ref sum = (f32 0.0) in
    let a_coords_array = malloc (to_uint32 2) in
    let b_coords_array = malloc (to_uint32 2) in
    let r_coords_array = malloc (to_uint32 2) in
 
    if is_not_null a_coords_array && is_not_null b_coords_array && is_not_null r_coords_array then 
        begin
            flag <- True;
            for i = 0 to rows - 1 do
                invariant { sum = 0.0 }
                invariant {
                    forall ii:int, jj:int.
                        0 <= ii < i ->
                        0 <= jj < cols ->
                        (ref_tensor r).Tensor.data (Cons ii (Cons jj Nil)) =
                            dot_product (ref_tensor a) (ref_tensor b) ii jj 0 iter
                }
                for j = 0 to cols - 1 do
                    invariant { sum = 0.0 }
                    invariant {
                        forall ii, jj:int.
                            0 <= ii < i ->
                            0 <= jj < cols ->
                            (ref_tensor r).Tensor.data (Cons ii (Cons jj Nil)) =
                                dot_product (ref_tensor a) (ref_tensor b) ii jj 0 iter
                    }
                    invariant {
                        forall jj:int.
                            0 <= jj < j ->
                            (ref_tensor r).Tensor.data (Cons i (Cons jj Nil)) =
                                dot_product (ref_tensor a) (ref_tensor b) i jj 0 iter
                    }
                    for k = 0 to iter - 1 do
                        invariant { sum = dot_product (ref_tensor a) (ref_tensor b) i j 0 k }
                        set_ofs a_coords_array 0 i;
                        set_ofs a_coords_array 1 k;
                        set_ofs b_coords_array 0 k;
                        set_ofs b_coords_array 1 j;
    
                        ghost
                            begin
                                valid_bounds_2 a_coords_array a.t_dims 0 2;
                                (* assert { Range.valid (ivector a_coords_array a.t_rank) (ivector a.t_dims a.t_rank) }; *)
    
                                valid_bounds_2 b_coords_array b.t_dims 0 2;
                                (* assert { Range.valid (ivector b_coords_array b.t_rank) (ivector b.t_dims b.t_rank) }; *)
    
                                dot_product_aux_step (ref_tensor a) (ref_tensor b) (to_int i) (to_int j) 0 (to_int k) (to_int iter);
                            end;
    
                        let a_coords = coffset a_coords_array a.t_dims a.t_rank in
                        let b_coords = coffset b_coords_array b.t_dims b.t_rank in
                        let a_val = a.t_data[a_coords] in
                        let b_val = b.t_data[b_coords] in
    
                        assert {Cons ((i)) (Cons ((k)) Nil) = ivector a_coords_array a.t_rank };
                        assert { (ref_tensor a).Tensor.data (Cons ((i)) (Cons ((k)) Nil)) = value_at a.t_data a_coords };
                
                        assert {Cons ((k)) (Cons ((j)) Nil) = ivector b_coords_array b.t_rank };
                        assert { (ref_tensor b).Tensor.data (Cons ((k)) (Cons ((j)) Nil)) = value_at b.t_data b_coords };
    
                        sum <- sum .+ (a_val .* b_val);

                    done;

                    set_ofs r_coords_array 0 i;
                    set_ofs r_coords_array 1 j;
                    let r_coords = coffset r_coords_array r.t_dims r.t_rank in
    
                    assert { Cons i (Cons j Nil) = ivector r_coords_array r.t_rank };
                    assert { r_coords = CFlat.offset (Cons i (Cons j Nil)) (ivector r.t_dims r.t_rank) };
    
                    r.t_data[r_coords] <- sum;
    
                    (* O valor no tensor e no ctensor é o mesmo *)
                    assert { (ref_tensor r).Tensor.data (Cons i (Cons j Nil)) = value_at r.t_data r_coords };
    
                    (* Diferentes valores coordenadas tem sempre diferentes offsets *)
                    assert {
                        forall jj:int.
                            0 <= jj < j ->
                            CFlat.offset (Cons i (Cons jj Nil)) (ivector r.t_dims r.t_rank) <> r_coords
                    };

                    sum <- (f32 0.0);

                done;

            done;
    
            (* Colocamos porque a matmul usa o get_dim *)
            assert { ivector a.t_dims a.t_rank = Cons (to_int rows) (Cons (to_int iter) Nil) };
            assert { ivector b.t_dims b.t_rank = Cons (to_int iter) (Cons (to_int cols) Nil) };
            assert { ivector r.t_dims r.t_rank = Cons (to_int rows) (Cons (to_int cols) Nil) };
            assert { rows = get_dim (ref_tensor a).Tensor.dims 0 };
            assert { cols = get_dim (ref_tensor b).Tensor.dims 1 };
            assert { iter = get_dim (ref_tensor a).Tensor.dims 1 };
    
            assert { ref_tensor r == matmul (ref_tensor a) (ref_tensor b) };
            flag
        end
    else
        flag
 
end

module COPMatmulGraph
    use mach.c.C
    use int.Int
    use map.Map
    use array.Array
    use centities.CEntities
    use libtensor.CTensor
    use tensor.Tensor
    use COPMatmul
    use OPMatmulGraph
    use std.Clib
    use entities.TensorValue
    use entities.WrapperTensor
    use option.Option
    use list.Length
    use std.Int

    predicate constraints (a b r: ctensor_value) =
    let a' = a.value in
    let b' = b.value in
    let r' = r.value in
    valid_tensor a' /\
    valid_tensor b' /\
    valid_tensor r' /\
    value_at a'.t_dims 1 = value_at b'.t_dims 0 /\
    value_at r'.t_dims 0 = value_at a'.t_dims 0 /\
    value_at r'.t_dims 1 = value_at b'.t_dims 1 /\
    a'.t_rank = b'.t_rank = r'.t_rank = 2 /\
    length (ref_tensor a').Tensor.dims = length (ref_tensor b').Tensor.dims = length (ref_tensor r').Tensor.dims = 2 /\
    get_dim (ref_tensor a').Tensor.dims 1 = get_dim (ref_tensor b').Tensor.dims 0

    let cmatmul_graph (a b r: ctensor_value)
    requires { constraints a b r }
    =
    COPMatmul.matmul a.value b.value r.value

    val get (p:ptr ctensor_value) : ctensor_value
    requires { p.min <= p.offset < p.max }
    ensures { result = Map.get (pelts p) (p.offset) }

    val set (p:ptr ctensor_value) (v:ctensor_value) : unit
    requires { p.min <= p.offset < p.max }
    requires { writable p }
    ensures { pelts p = Map.set (pelts (old p)) p.offset v }
    writes { C.(p.data.elts) }

    let cmatmul_graph_ptr (a: ctensor_value) (b: ctensor_value) (r: ptr ctensor_value): bool
    requires { constraints a b (Map.get (pelts r) (r.offset)) }
    requires { valid_range r 0 1 }
    requires { writable r }
    ensures { result -> ((Map.get (pelts r) (r.offset)).CEntities.computed = true) }
    ensures { result -> (Some (R (CTensor.ref_tensor (Map.get (pelts r) (r.offset)).value)) = OPMatmulGraph.matmul_graph (Some (R (CTensor.ref_tensor a.value))) (Some (R (CTensor.ref_tensor b.value)))) }
    ensures { result -> (forall j: int. j <> r.offset -> Map.get (pelts r) j = Map.get (pelts (old r)) j) }
    ensures { not result -> forall j: int. Map.get (pelts r) j = Map.get (pelts (old r)) j }
    ensures { CTensor.valid_tensor (Map.get (pelts r) r.offset).value }
    =
    let ref r_val = get r in
    let flag = COPMatmul.matmul a.value b.value r_val.value in
    if flag then 
        begin
            r_val.computed <- true;
            set r r_val;
            true
        end
    else
        false

end
